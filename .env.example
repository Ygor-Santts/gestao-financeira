# Copie para .env e preencha. O .env nunca vai para o Git.

# Senha para entrar no app
FINANCAS_SENHA=troque-esta-senha

# Porta no computador (o app fica em http://localhost:PORTA)
PORTA=8080

# Gmail: para o app buscar sozinho os extratos que chegam por e-mail.
# A senha NÃO é a do Gmail: é uma "senha de app" (veja o README).
GMAIL_EMAIL=
GMAIL_SENHA_APP=

# Pasta extra para guardar uma cópia dos backups (ex.: uma pasta do Google Drive
# no Windows). Usada pelo script de atualização automática. Deixe vazio para não copiar.
PASTA_BACKUP_NUVEM=
