{
  "name": "Finanças",
  "short_name": "Finanças",
  "description": "O que entrou, o que você gastou e o que está guardado.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f3f9",
  "theme_color": "#2e1868",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": [".ofx", ".csv", ".pdf", "application/pdf", "text/csv", "application/x-ofx", "application/octet-stream"] }] }
  }
}
